# ==============================================================================
# InternProof AI — Master Environment Configuration Template
# NOTE: Do NOT place real secrets in this file. Copy to .env for local usage.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Client URL (for CORS and cookie origin validation)
CLIENT_URL=http://localhost:5173

# Database Connection (Prisma)
# Local SQLite default (zero external dependencies): file:./dev.db
# Production PostgreSQL example: postgresql://postgres:password@localhost:5432/internproof?schema=public
DATABASE_URL=file:./dev.db

# Authentication Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET=internproof_jwt_secret_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d

# Optional AI Providers (Leave blank to use intelligent offline career advisor mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Push Notification VAPID Keys (Optional)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@internproof.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
